(footprint "RotaryEncoder_TTC_5mm_SideMount_3Pin"
	(version 20241229)
	(generator "vibecoder-handbuilt")
	(layer "F.Cu")
	(descr "TTC 5 mm encoder laid flat on the board, THREE SURFACE PADS ONLY - no drilled holes. The encoder body lies face-down on the PCB and the three signal legs are bent down onto the pads and hand-soldered; the two large metal retaining tabs are deliberately absent because the user breaks them off, so the part is held by the enclosure and the three solder joints. Pad 1.50 x 5.00 mm on a 2.50 mm pitch. Leg measured from the 3D model is a 0.76 x 0.19 mm flat blade sticking 3.7 mm out of the body, so the pad is about 2x the leg width and 1.3x its length - deliberately oversized for hand soldering and to absorb the pitch tolerance (the 3D model measures 2.3775 mm pitch, the mechanical drawing says 2.50; a 1.50 mm pad covers both). Pads A/C/B match Device:RotaryEncoder; A and B are interchangeable and only set which way counts up. 3D placement (rotate -90 X, offset 0/5.408/3.994) was verified by rendering this footprint with kicad-cli, not estimated: body sits flush on the copper and the legs float 1.0 mm above the pads, which is the gap you close when you bend them.")
	(tags "rotary encoder TTC mouse wheel flat lay smd 3pin hand solder")
	(attr smd)
	(property "Reference" "SW"
		(at 0 -12.2 0)
		(layer "F.SilkS")
		(uuid "b0000000-0000-4000-8000-000000000001")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "RotaryEncoder_TTC_5mm_SideMount_3Pin"
		(at 0 4.6 0)
		(layer "F.Fab")
		(uuid "b0000000-0000-4000-8000-000000000002")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Description" "TTC 5 mm encoder laid flat, 3 surface pads, legs bent down"
		(at 0 0 0)
		(layer "F.Fab")
